# Site Configuration
NEXT_PUBLIC_SITE_URL=https://unclesamjunkremoval.com

# Email Service (Required for quote form)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Analytics (Optional)
# Ahrefs Website Analytics
NEXT_PUBLIC_AHREFS_KEY=your_ahrefs_key_here

# Emergency Banner Control
# Set to 'false' to disable the emergency banner sitewide
# Leave unset or set to 'true' to enable the banner
NEXT_PUBLIC_EMERGENCY_BANNER_ENABLED=true

# Google Analytics is configured in app/layout.tsx
# Microsoft Clarity is configured in app/layout.tsx
# Vercel Analytics (automatically enabled on Vercel - no configuration needed)
