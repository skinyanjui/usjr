# ==============================================================================
# EMAIL CONFIGURATION (RESEND)
# ==============================================================================

# Resend API Key for email sending
# Get your API key from https://resend.com/api-keys
# Used for quote request notifications and customer confirmation emails
RESEND_API_KEY=your_resend_api_key_here

# IMPORTANT: After setting up Resend, you MUST add DNS records to your domain
# to ensure emails are delivered properly and not marked as spam.
#
# Required DNS Records (Add these to your domain's DNS settings):
#
# 1. SPF Record (TXT Record)
#    Host/Name: @
#    Value: v=spf1 include:_spf.resend.com ~all
#    TTL: 3600
#
# 2. DKIM Record (TXT Record)
#    Host/Name: resend._domainkey
#    Value: p=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQC8qYCRLLCeGOhGLH09MZNZS5ZSjcnax5r5gLDJOMx88nXVvbBzzfeBZe164DrieDXhmHUiOMi2k5hVb1C4KbAYG+sQAOs60sZsTV+7CWawCbhcVS1nHqjxQuuHx4Aq5hoUPYennzXiwl/ODENfeYlxEED7HGuutMv1I1QpmFUjpwIDAQAB
#    TTL: 3600
#
# 3. DMARC Record (TXT Record) - Recommended
#    Host/Name: _dmarc
#    Value: v=DMARC1; p=none; rua=mailto:your-email@yourdomain.com
#    TTL: 3600
#
# After adding DNS records:
# 1. Go to https://resend.com/domains
# 2. Add your domain
# 3. Verify the DNS records are detected
# 4. Wait for verification (15 min - 48 hours for DNS propagation)
#
# See README.md "Email Configuration (Resend)" section for detailed setup instructions

# ==============================================================================
# SITE CONFIGURATION
# ==============================================================================

# Emergency Banner Control
# Set to 'false' to disable the emergency banner sitewide
# Leave unset or set to 'true' to enable the banner
# The banner persists dismissal in localStorage for 24 hours
NEXT_PUBLIC_EMERGENCY_BANNER_ENABLED=true
